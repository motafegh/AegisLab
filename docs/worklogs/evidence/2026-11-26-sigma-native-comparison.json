(SELECT m.metric FROM sigma_e573171c0533_n0_metrics m WHERE m.g0 = a.g0 AND m.g1 = a.g1 AND m.end=a.end) AS metric FROM sigma_e573171c0533_n0_t0_anchors a WHERE 1), sigma_e573171c0533_n0_t0_qualified AS (SELECT * FROM sigma_e573171c0533_n0_t0_measured WHERE metric >= 3), sigma_e573171c0533_n0_combined AS (SELECT a.start, a.end, g0, g1, a.metric, (SELECT json_group_array(DISTINCT e.value) FROM sigma_e573171c0533_n0_matches m, json_each(m.evidence) e WHERE e.type='text' AND m.g0 = a.g0 AND m.g1 = a.g1 AND m.ts BETWEEN a.start AND a.end) AS evidence, (SELECT json_group_array(DISTINCT c.value) FROM sigma_e573171c0533_n0_matches m, json_each(m.children) c WHERE c.type='text' AND m.g0 = a.g0 AND m.g1 = a.g1 AND m.ts BETWEEN a.start AND a.end) AS children FROM sigma_e573171c0533_n0_t0_qualified a), sigma_e573171c0533_n0_grouped AS (SELECT start, end, g0, g1, MAX(metric) AS metric, json_group_array(json(evidence)) AS evidence, json_group_array(json(children)) AS children FROM sigma_e573171c0533_n0_combined GROUP BY start, end, g0, g1), sigma_e573171c0533_n0_merged AS (SELECT start, end, g0, g1, metric, (SELECT json_group_array(value) FROM (SELECT DISTINCT e.value FROM json_each(w.evidence) a, json_each(a.value) e ORDER BY e.value)) AS evidence, (SELECT json_group_array(value) FROM (SELECT DISTINCT e.value FROM json_each(w.children) a, json_each(a.value) e ORDER BY e.value)) AS children FROM sigma_e573171c0533_n0_grouped w), sigma_e573171c0533_n0_alerts AS (SELECT 'sigma_alert_e573171c05336dad:' || ROW_NUMBER() OVER (ORDER BY g0, g1, end, start, metric, evidence) AS alert_id, start, end, json_object('source_ip', `g0`, 'username', `g1`) AS group_keys, metric, evidence, children, g0, g1 FROM sigma_e573171c0533_n0_merged) SELECT alert_id, group_keys, end AS occurrence_time, start AS window_start, end AS window_end, 'event_count' AS metric_name, metric AS metric_value, json_array_length(evidence) AS event_count, CASE WHEN instr(evidence, '\\u0001') THEN replace(replace(replace(evidence, '\\\\', '\\u005c'), '\\u00010', '\\u0000'), '\\u00011', '\\u0001') ELSE evidence END AS event_ids, CASE WHEN instr(children, '\\u0001') THEN replace(replace(replace(children, '\\\\', '\\u005c'), '\\u00010', '\\u0000'), '\\u00011', '\\u0001') ELSE children END AS child_alert_ids FROM sigma_e573171c0533_n0_alerts ORDER BY occurrence_time, alert_id",
